---
import { site } from '../data/site';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** 404などインデックス不要なページで true にする */
  noindex?: boolean;
}

const siteName = `${site.name.replace(/\s+/g, '')}のポートフォリオ`;
const defaultTitle = `${site.name.replace(/\s+/g, '')}｜Web制作・マーケティング`;
const { title = defaultTitle, description = site.description, noindex = false } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const asset = (path: string) => (Astro.site ? new URL(`${base}/${path}`, Astro.site) : undefined);
const canonical = !noindex && Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
// LINE・Slackなど一部サービスはWebPのOGP画像を表示できないためPNGを使用
const ogImage = asset('og-fv.png');
const profileImage = asset('profile.webp');
const siteUrl = Astro.site ? new URL(`${base}/`, Astro.site).href : undefined;

const structuredData = canonical && siteUrl && {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}#website`,
      url: siteUrl,
      name: siteName,
      alternateName: [site.name.replace(/\s+/g, ''), site.englishName],
      inLanguage: 'ja',
    },
    {
      '@type': 'ProfilePage',
      '@id': canonical.href,
      url: canonical.href,
      name: title,
      inLanguage: 'ja',
      isPartOf: { '@id': `${siteUrl}#website` },
      mainEntity: {
        '@type': 'Person',
        '@id': `${canonical.href}#person`,
        name: site.name,
        alternateName: [site.name.replace(/\s+/g, ''), site.englishName],
        url: canonical.href,
        description: site.description,
        ...(profileImage && { image: profileImage.href }),
        affiliation: { '@type': 'CollegeOrUniversity', name: '大阪大学' },
        sameAs: [site.contact.x, site.contact.github].filter(Boolean),
      },
    },
  ],
};
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {site.googleSiteVerification && <meta name="google-site-verification" content={site.googleSiteVerification} />}
    <meta name="theme-color" content="#f7f7f4" />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:type" content="image/png" />}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="630" />}
    {ogImage && <meta property="og:image:alt" content="つくって 届けて 育てていく。表川知由のポートフォリオ" />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" href={`${base}/favicon.webp`} type="image/webp" sizes="256x256" />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <link rel="sitemap" type="application/xml" href={`${base}/sitemap.xml`} />
    {structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />}
  </head>
  <body><slot /></body>
</html>
