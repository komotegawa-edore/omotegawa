---
import { site } from '../data/site';
import '../styles/global.css';
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const ogImage = Astro.site ? new URL(`${import.meta.env.BASE_URL.replace(/\/$/, "")}/og-fv.webp`, Astro.site) : undefined;
const profileImage = Astro.site ? new URL(`${import.meta.env.BASE_URL.replace(/\/$/, "")}/profile.webp`, Astro.site) : undefined;
const structuredData = canonical && {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  '@id': canonical.href,
  url: canonical.href,
  inLanguage: 'ja',
  mainEntity: {
    '@type': 'Person',
    '@id': `${canonical.href}#person`,
    name: site.name,
    alternateName: [site.name.replace(/\s+/g, ''), site.englishName],
    url: canonical.href,
    description: site.description,
    ...(profileImage && { image: profileImage.href }),
    affiliation: { '@type': 'CollegeOrUniversity', name: '大阪大学' },
    sameAs: [site.contact.x, site.contact.github].filter(Boolean),
  },
};
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={site.description} />
    <meta name="theme-color" content="#f7f7f4" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:title" content={`${site.name} | ${site.englishName}`} />
    <meta property="og:description" content={site.description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="630" />}
    {ogImage && <meta property="og:image:alt" content="つくって 届けて 育てていく。表川知由のポートフォリオ" />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <link rel="icon" href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/favicon.webp`} type="image/webp" />
    <title>表川知由 | Kazuyoshi Omotegawa</title>
    {structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />}
  </head>
  <body><slot /></body>
</html>
