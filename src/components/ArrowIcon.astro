---
interface Props { direction?: 'up-right' | 'down-right' | 'down' | 'up'; }
const { direction = 'up-right' } = Astro.props;
const rotations = { 'up-right': 0, 'down-right': 90, down: 135, up: -45 };
---
<svg class="arrow-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true" style={`transform: rotate(${rotations[direction]}deg)`}><path d="M4 16 16 4M6 4h10v10" stroke="currentColor" stroke-width="1.25" stroke-linecap="square" /></svg>
